# ============================================================
# LitHub — Variables de entorno
# ============================================================
# Copia este archivo como .env.local para desarrollo local.
# NUNCA subas .env.local ni .env con credenciales reales al repositorio.
# ============================================================

# ------ Base de datos (Neon PostgreSQL) ------
# URL con connection pooling (para queries en producción/Vercel Serverless)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/lithub?sslmode=require"

# URL directa sin pooler (necesaria para prisma migrate en producción)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/lithub?sslmode=require"

# ------ Autenticación ------
# Genera un secreto seguro: openssl rand -base64 64
JWT_SECRET="CHANGE_ME_use_a_long_random_secret_of_at_least_32_chars"

# ------ Entorno de Node ------
# Vercel lo establece automáticamente, no es necesario definirlo manualmente.
# NODE_ENV=production
